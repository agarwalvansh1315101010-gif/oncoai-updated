generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  passwordHash        String
  role                String          @default("PATIENT")
  isVerified          Boolean         @default(false)
  verificationCode    String?
  verificationExpires DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?
  auditLogs      AuditLog[]
}

model PatientProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  assignedDoctorId String?
  assignedDoctor   DoctorProfile?    @relation("DoctorPatients", fields: [assignedDoctorId], references: [id])
  
  consentRecord    ConsentRecord?
  medicalRecords   MedicalRecord[]
  documents        UploadedDocument[]
  queries          Query[]
  appointments     Appointment[]
  aiReports        AiReport[]
  latestInsight    String?
  reportVectors    PatientReportVector[]
}

model DoctorProfile {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  specialization String
  licenseNumber  String
  
  patients       PatientProfile[] @relation("DoctorPatients")
  responses      Response[]
  appointments   Appointment[]
}

model ConsentRecord {
  id               String         @id @default(uuid())
  patientId        String         @unique
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  agreedToTerms    Boolean        @default(false)
  agreedToDataUse  Boolean        @default(false)
  agreedAt         DateTime       @default(now())
  ipAddress        String?
}

model MedicalRecord {
  id               String         @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encryptedNotes   String
  diagnosis        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model UploadedDocument {
  id               String         @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int            @default(0)
  uploadedAt       DateTime       @default(now())
}

model Query {
  id               String         @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  subject          String
  encryptedMessage String
  status           String         @default("PENDING")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  responses        Response[]
}

model Response {
  id               String         @id @default(uuid())
  queryId          String
  query            Query          @relation(fields: [queryId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  encryptedMessage String
  createdAt        DateTime       @default(now())
}

model AiReport {
  id               String         @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  summary          String
  riskLevel        String         @default("UNKNOWN")
  findings         String
  recommendations  String
  doctorNotes      String?
  status           String         @default("PENDING")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Appointment {
  id               String         @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  scheduledAt      DateTime
  type             String         @default("VIDEO")
  status           String         @default("SCHEDULED")
  notes            String?
  createdAt        DateTime       @default(now())
}

model AuditLog {
  id               String         @id @default(uuid())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action           String
  resourceType     String
  resourceId       String?
  details          String?
  ipAddress        String?
  createdAt        DateTime       @default(now())
}

model PatientReportVector {
  id               String         @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  content          String
  embedding        String
  createdAt        DateTime       @default(now())
}
